{
    "name": "neo/neocms-bundle",
    "description": "NEOcms by Contao: NEO Digital back end look for Contao 5 (Fluent icons, collapsible navigation, card layout, light/dark) and front end links on the main domain.",
    "type": "contao-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Erich Nigg (NEO Digital)",
            "homepage": "https://neo-digital.at"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.7"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/test-case": "^5.7",
        "phpunit/phpunit": "^12.4"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Neo\\ContaoNeocmsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neo\\ContaoNeocmsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Neo\\ContaoNeocmsBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
